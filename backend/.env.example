# Copiar este archivo como .env y completar los marcadores

# PostgreSQL (psycopg 3). También se acepta "postgresql://...".
# Para desarrollo sin PostgreSQL: DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql+psycopg://postgres:<contraseña>@localhost:5432/foodstore_db

# Mínimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generar>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (usar localhost, no 127.0.0.1)
FRONTEND_ORIGIN=http://localhost:5173

# true solo con HTTPS (producción)
COOKIE_SECURE=false
